# Supabase（Project Settings → API Keys / Data API で確認）
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx

# Claude API（https://platform.claude.com で作成）。スクショ取り込みに使う
ANTHROPIC_API_KEY=

# 使うAI（空なら claude-haiku-5-5。精度を上げたいときは claude-sonnet-5-5）
ANTHROPIC_MODEL=

# 使える人のメールアドレス（カンマ区切り）。他人にAIを使われないための設定
ALLOWED_EMAILS=you@example.com
